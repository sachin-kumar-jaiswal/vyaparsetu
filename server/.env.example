# VyaparSetu Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/vyaparsetu

# JWT Configuration
JWT_SECRET=vyaparsetu_super_secret_jwt_key_2026_dev_env
JWT_EXPIRES_IN=7d

# CORS Configuration - Allowed Frontend Origin
FRONTEND_URL=http://localhost:5173

# Initial Super Admin Provisioning (Used during bootstrap)
ADMIN_NAME=VyaparSetu Administrator
ADMIN_EMAIL=admin@vyaparsetu.in
ADMIN_PASSWORD=AdminSecure@2026
ADMIN_PHONE=+919876543210

# Optional Cloudinary Configuration (for persistent uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
